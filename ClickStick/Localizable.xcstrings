            "value" : "Tento text bude odeslán lidskou rychlostí. Zbývá %lld bajtů plné rychlosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text wird in menschlicher Geschwindigkeit gesendet. Es verbleiben %lld Bytes in voller Geschwindigkeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
