          }
        }
      }
    },
    "This will remove the saved authentication key. You'll need to set up the device again to reconnect." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto odstraníte uložený ověřovací klíč. Pro opětovné připojení bude nutné zařízení znovu nastavit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird der gespeicherte Authentifizierungsschlüssel entfernt. Sie müssen das Gerät erneut einrichten, um es wieder zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará la clave de autenticación guardada. Necesitarás configurar el dispositivo de nuevo para reconectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera la clé d'authentification enregistrée. Vous devrez reconfigurer l'appareil pour vous reconnecter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された認証キーが削除されます。再接続するにはデバイスを再設定する必要があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to usunięcie zapisanego klucza uwierzytelniania. Aby ponownie się połączyć, konieczne będzie ponowne skonfigurowanie urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso removerá a chave de autenticação salva. Você precisará configurar o dispositivo novamente para reconectar."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tým sa odstráni uložený overovací kľúč. Na opätovné pripojenie bude potrebné zariadenie znova nastaviť."
          }
        }
      }
    },
    "To scan the QR code, allow ClickStick to access your camera in Settings." : {
